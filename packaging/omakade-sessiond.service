[Unit]
Description=Omakade session recorder and resident game guide
PartOf=graphical-session.target
After=graphical-session.target
Documentation=https://github.com/btsouth/omakade

[Service]
ExecStart=/usr/bin/omakade-sessiond
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
