[Unit]
Description=Omakade Game Mode controller button
Documentation=https://github.com/btsouth/omakade/blob/main/docs/GAME-MODE.md
PartOf=graphical-session.target
Wants=omakade-sessiond.service
After=graphical-session.target omakade-sessiond.service

[Service]
ExecStart=/usr/bin/omakade-guide-button
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78

[Install]
WantedBy=graphical-session.target
