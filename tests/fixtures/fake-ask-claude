#!/bin/bash
# Stands in for `claude -p` with stream-json in and out: logs its arguments to $FAKE_ASK_LOG,
# one per line, and the message it was given to $FAKE_ASK_LOG.input, then answers.
printf '%s\n' "$@" > "$FAKE_ASK_LOG"
cat > "$FAKE_ASK_LOG.input"
echo '{"type":"system","subtype":"init"}'
echo '{"type":"result","subtype":"success","is_error":false,"result":"Head out through the garage door."}'
